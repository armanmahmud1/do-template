**# Setup Stata
*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
	
	discard
	clear           all
	macro drop      _all
	set min_memory  1g
	set more        off 
	set niceness    1
	set traced      1 
	pause           on
	set seed        87235
	set sortseed    87235
	version         11
	set maxvar      32767	
	
**# Setup working directory
*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*

	if "$cwd" ~= "" cd "$cwd"
	else global cwd "`c(pwd)'"
	sysdir set PLUS "01_Ado"
	
